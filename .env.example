# Portfolio Configuration (Copy this file to .env and fill in your values)
# Note: Only VITE_* variables are exposed to the Vite frontend bundle. Never store secret API keys here.

# Contact Information
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# Contact Form Backend (e.g., https://formspree.io/f/your_form_id)
VITE_FORMSPREE_ENDPOINT=

# Resume Download URL (files inside public/ are served at ./Resume.pdf or /portfollio/Resume.pdf)
VITE_RESUME_URL=./Resume.pdf

# Education Details (BCA)
VITE_BCA_COLLEGE = 
VITE_BCA_DATES= 

# Project URLs (Optional overrides)
VITE_UMCAO_REPO_URL=
VITE_UMCAO_DEMO_URL=https://umcao.onrender.com/
VITE_BOOKSTORE_REPO_URL=
VITE_BOOKSTORE_DEMO_URL=

